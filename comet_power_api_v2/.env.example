# --- Security (set before going public) ---
# Comma-separated keys your frontend/server will send. Make long random strings.
COMET_API_KEYS=change-me-long-random-string
# Your website origin(s), comma-separated. Use * only while testing.
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=20

# --- Model providers (set at least one key; order = fallback order) ---
LLM_PROVIDERS=groq,openrouter,huggingface,gemini
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
# Optional: override a default model if a provider retires it
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Behaviour ---
SYSTEM_PROMPT=You are COMET, a helpful, accurate and friendly AI assistant.
MAX_TOKENS_CAP=2048
